{
  "name": "@dokuvault/desktop",
  "version": "0.0.1",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -p tsconfig.node.json && vite build && electron-builder --publish never",
    "build:win": "tsc -p tsconfig.node.json && vite build && electron-builder --win --publish never",
    "build:mac": "tsc -p tsconfig.node.json && vite build && electron-builder --mac --publish never",
    "type-check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "clean": "rm -rf dist dist-electron"
  },
  "dependencies": {
    "@dokuvault/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "chokidar": "^4.0.3",
    "electron-store": "^10.0.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-router-dom": "^7.1.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dokuvault.desktop",
    "productName": "DokuVault",
    "copyright": "Copyright © 2026",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": { "output": "release" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    }
  }
}
